# Copy to .env to override defaults. Read by docker compose and the Makefile.
PHP_VERSION=8.3
WP_VERSION=latest
PROVIDER=polylang
WP_PORT=8080
MAILPIT_PORT=8025
# Path to a WPML zip as seen inside the containers (./private is mounted at /private), e.g. /private/wpml.zip.
# Alternatively drop the zips into ./private/wpml/.
WPML_ZIP_PATH=
