{
	"name": "gettilt/translation-drift",
	"description": "Outdated translation tracker for Polylang and WPML.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"brain/monkey": "^2.7",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"php-stubs/acf-pro-stubs": "^6.8",
		"php-stubs/wordpress-tests-stubs": "^7.1",
		"php-stubs/wp-cli-stubs": "^2.12",
		"phpcompatibility/phpcompatibility-wp": "^2.1.8",
		"phpstan/extension-installer": "^1.4",
		"phpstan/phpstan": "^2.2",
		"phpunit/phpcov": "^8.2",
		"phpunit/phpunit": "^9.6",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"wp-coding-standards/wpcs": "^3.4",
		"wpsyntex/polylang-stubs": "^3.7",
		"yoast/phpunit-polyfills": "^4.0"
	},
	"autoload": {
		"psr-4": {
			"TranslationDrift\\": "includes/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"TranslationDrift\\Tests\\Unit\\": "tests/unit/",
			"TranslationDrift\\Tests\\Integration\\": "tests/integration/"
		}
	},
	"config": {
		"optimize-autoloader": true,
		"sort-packages": true,
		"platform": {
			"php": "8.1.0"
		},
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true
		}
	},
	"scripts": {
		"lint": "phpcs",
		"phpcompat": "phpcs --standard=PHPCompatibilityWP --runtime-set testVersion 8.1-8.4 --extensions=php --ignore=vendor/*,node_modules/*,build/* -p .",
		"phpstan": "phpstan analyse --memory-limit=1G",
		"test:unit": "phpunit -c phpunit.xml.dist",
		"test:integration": "phpunit -c phpunit-integration.xml.dist"
	}
}
