{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"isolatedModules": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"types": [ "jest", "node" ],
		"lib": [ "ES2022", "DOM", "DOM.Iterable" ]
	},
	"include": [ "src", "tests/js", "tests/e2e", "playwright.config.ts" ]
}
